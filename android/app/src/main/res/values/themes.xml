<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuantumCli" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#020308</item>
        <item name="android:navigationBarColor">#020308</item>
        <item name="android:windowBackground">#02040A</item>
    </style>

    <style name="TextAppearance.Quantum.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">#00E5FF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.6</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Quantum.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">#E6F7FF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="Widget.Quantum" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">#E6F7FF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="Widget.Quantum.Divider">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:background">#1AE5FF33</item>
    </style>

    <style name="Theme.QuantumCli.Full" parent="Theme.QuantumCli">
    </style>

    <style name="Theme.QuantumCli.Limited" parent="Theme.QuantumCli">
    </style>
</resources>